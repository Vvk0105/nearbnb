# Copy to .env and fill in. Never commit .env.

# APP_ENV: development locally, production on the server
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
# Production example: CORS_ORIGINS=https://nearbnb.com  COOKIE_DOMAIN=.nearbnb.com  API_DOMAIN=api.nearbnb.com
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
API_DOMAIN=

# Database
POSTGRES_DB=nearbnb
POSTGRES_USER=nearbnb
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://nearbnb:change-me@db:5432/nearbnb

# Redis
REDIS_URL=redis://redis:6379/0

# Email (SMTP). Leave SMTP_HOST empty in development: emails are printed in the worker log instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=NearBNB <noreply@nearbnb.com>
EMAIL_REPLY_TO=support@nearbnb.com

# Stripe (test keys until Phase 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google Places
GOOGLE_PLACES_API_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File storage
STORAGE_ROOT=/data/storage
